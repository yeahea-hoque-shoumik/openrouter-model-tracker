# Existing PostgreSQL server (must be reachable from the tracker container)
DATABASE_URL=postgresql://user:password@host:5432/dbname
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POLL_INTERVAL_HOURS=12
# true: Telegram report on every run; false: only when the free set changes
NOTIFY_EVERY_RUN=true
# Optional: enables latency/throughput lookup per model (left empty they stay NULL)
OPENROUTER_API_KEY=
